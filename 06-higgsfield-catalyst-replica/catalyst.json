{
  "name": "higgsfield-catalyst-replica",
  "version": "1.0.0",
  "description": "Open-Weights Sovereign Higgsfield Video AI Studio deployed on Zoho Catalyst",
  "client": {
    "source": "client"
  },
  "functions": [
    {
      "name": "higgsfield_api",
      "type": "AdvancedIO",
      "runtime": "python3.11",
      "source": "functions/higgsfield_api"
    }
  ],
  "appSail": [
    {
      "name": "inference-dispatcher",
      "source": "appsail/dispatcher",
      "build": "DOCKER",
      "port": 8000
    }
  ],
  "dataStore": {
    "tables": [
      "GenerationJobs",
      "SoulProfiles",
      "AssetMedia"
    ]
  },
  "fileStore": {
    "folders": [
      "raw_uploads",
      "soul_references",
      "rendered_videos"
    ]
  }
}
